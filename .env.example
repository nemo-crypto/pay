# 默认 demo 完全本地模拟；程序不自动加载 .env，启动前请 export。
PAY_MODE=demo
HTTP_ADDR=127.0.0.1:8098
PUBLIC_URL=http://127.0.0.1:8098
# 不同支付环境必须使用独立文件；已有非空旧库需先审计迁移，不能直接切换环境。
DATABASE_PATH=data/pay.db
JWT_ISSUER=pay-demo
JWT_AUDIENCE=pay-api
# live 模式必须设置随机 >=32 字节密钥和 HTTPS PUBLIC_URL。
# demo 固定使用演示密钥，忽略此变量；live 不接受公开演示密钥。
JWT_SECRET=
CHECKOUT_ALLOWED_ORIGINS=http://127.0.0.1:8098
DAILY_LIMIT_NT=100000
CUSTOM_TOPUP_ENABLED=false
PLANS_FILE=
# PAY_MODE=live 表示调用真实网关 API；Stripe 测试密钥仍可用于联调。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE=false
ALLSCALE_API_KEY=
ALLSCALE_API_SECRET=
# 固定报价：1 USD 等于多少 TWD；运营维护，每笔订单保存快照。
ALLSCALE_TWD_PER_USD=32.00
ALLSCALE_SIGNED_RESPONSES=false

# 微信支付：普通直连商户 API v3；demo 自动启用五种场景，不读取真实凭据。
# live 配置商户号即启用，以下商户和平台密钥配置须完整。
WECHAT_MCH_ID=
WECHAT_MERCHANT_SERIAL=
WECHAT_PRIVATE_KEY_FILE=
WECHAT_API_V3_KEY=
# 平台公钥模式，ID 通常以 PUB_KEY_ID_ 开头；PEM 类型为 PUBLIC KEY。
WECHAT_PLATFORM_KEY_ID=
WECHAT_PLATFORM_PUBLIC_KEY_FILE=
# 公众号 / H5 / Native 所绑定的 AppID
WECHAT_APP_ID=
# 按需配置；小程序及移动 App 的 AppID 不可混用。
WECHAT_MINI_APP_ID=
WECHAT_MOBILE_APP_ID=
# 1 CNY 等于多少 TWD；live 必须显式配置，订单冻结人民币分金额。
WECHAT_TWD_PER_CNY=
# 只有可信代理可以覆盖 X-Real-IP；代理必须移除客户端传入的同名头。
WECHAT_TRUSTED_PROXY_CIDRS=

# 四家法币买币模块：demo 自动启用全部 mock，以下只影响 PAY_MODE=live。
# live 中默认不启用；按需设为 moonpay,alchemypay,transak,ramp
ONRAMP_PROVIDERS=
ONRAMP_ENV=sandbox
MOONPAY_PUBLIC_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_KEY=
ALCHEMYPAY_APP_ID=
ALCHEMYPAY_APP_SECRET=
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
RAMP_HOST_API_KEY=
# 只填可信反向代理网段，并确保代理覆盖 X-Real-IP。
ONRAMP_TRUSTED_PROXY_CIDRS=
